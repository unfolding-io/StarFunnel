---
import { getEntry } from "astro:content";
import { t } from "@util/translate";
import { marked } from "marked";
import SmartPicture from "@components/media/SmartPicture.astro";
import { sizesContactDialog, widthsForDisplay } from "@util/images";
import BaseHead from "@components/BaseHead.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Contact from "@components/form/Contact.vue";
import Dialog from "@components/dialog/Dialog.vue";
import Newsletter from "@components/form/Newsletter.vue";
import Auth from "@components/form/Auth.vue";
import Init from "@components/common/Init.vue";
import { buildSurfaceStyles } from "@util/surfaces";

const lang = import.meta.env.WEBSITE_LANGUAGE || "en";
const currency = import.meta.env.CURRENCY || "USD";
const { title, description, page_class, thumbnail, og_image, nav_color } =
  Astro.props;
const navigation = await getEntry("config", "navigation");
const about = await getEntry("config", "about");
const contact = await getEntry("config", "contact");
const styleConfig = await getEntry("config", "style");
const surfaceCss = buildSurfaceStyles(styleConfig?.data?.surface ?? []);

type NewsletterItem = {
  title?: string;
  intro?: string;
  link?: string;
  status?: string;
  thanks?: string;
  thumbnail?: string;
  list?: unknown;
  tags?: string[];
  id?: string;
  include_main_list?: boolean;
};

const newsletters = (): NewsletterItem[] => {
  if (!contact?.data?.newsletter) return [];
  const data = JSON.parse(
    JSON.stringify(contact.data.newsletter),
  ) as NewsletterItem;
  let items: NewsletterItem[] = [];
  if (
    contact?.data?.newsletter?.list &&
    contact.data.newsletter.list.length > 0
  ) {
    items = contact.data.newsletter.list as NewsletterItem[];
    delete data.list;
  }

  return [...items, data];
};
---

<!doctype html>
<html lang={lang} data-currency={currency} data-is-top="true">
  <head>
    <BaseHead
      title={title}
      description={description}
      thumbnail={!!og_image ? og_image : thumbnail}
    />
    {surfaceCss && <style is:inline set:html={surfaceCss} />}
  </head>
  <body class={`surface-base ${page_class || ""}`}>
    <Header
      title={title}
      color={nav_color}
      menu={navigation?.data?.main_menu}
      cta={navigation?.data?.cta_menu}
      social={contact?.data?.social}
      about={about?.data}
    />
    <main>
      <slot />
    </main>
    <div
      class="pointer-events-none sticky bottom-0 right-0 z-40 -mb-8 h-8 w-full"
    >
      <div class="container-xl absolute bottom-0 flex justify-end">
        <a
          href="#top"
          aria-label={t("back_to_top")}
          class="btn surface-primary btn-to-top group pointer-events-auto grid h-10 w-10 -translate-y-4 place-items-center opacity-0"
        >
          <svg
            class="h-5 w-5 -rotate-90"
            xmlns="http://www.w3.org/2000/svg"
            xmlns:xlink="http://www.w3.org/1999/xlink"
            xml:space="preserve"
            style="enable-background: new 0 0 12 12"
            viewBox="0 0 12 12"
          >
            <g
              class="-translate-x-[20%] transition-transform duration-300 group-hover:translate-x-0"
            >
              <path
                d="M9.2 6.4 6.4 9.1c-.1.1-.1.4 0 .5s.4.1.5 0l3.4-3.4c.1-.1.1-.4 0-.5L7 2.4c-.1-.1-.4-.1-.5 0-.1.1-.1.4 0 .5l2.7 2.7c.4.4.4.4 0 .8z"
                fill="currentColor"
                stroke="currentColor"
                stroke-width="0.5"></path>
              <g>
                <path
                  class="origin-right -translate-x-[8%] scale-x-0 transition-transform duration-300 group-hover:scale-x-75"
                  d="M9.6 5.6H1.9c-.2 0-.3.2-.3.4s.2.4.4.4h7.7c.2 0 .4-.2.4-.4s-.3-.4-.5-.4z"
                  fill="currentColor"
                  stroke="currentColor"
                  stroke-width="0.5"></path>
              </g>
            </g>
          </svg>
        </a>
      </div>
    </div>

    <Footer>
      <slot name="footer" />
    </Footer>

    <Init client:interaction />
    <svg class="hide hidden">
      <filter id="noiseFilter">
        <feTurbulence
          type="fractalNoise"
          baseFrequency="2.29"
          numOctaves="1"
          stitchTiles="stitch"></feTurbulence>
      </filter>
    </svg>

    <script>
      import { initScrollFlags } from "@util/scrollFlags";
      import { bindModalLinks } from "@util/bindModalLinks";
      import { initStandaloneLightboxes } from "@components/media/initLightbox";

      const html = document.getElementsByTagName("html")[0];

      const SmoothScroll = () => {
        html.style.scrollBehavior = "auto";
      };
      SmoothScroll();
      document.addEventListener("astro:beforeload", SmoothScroll);

      // Nav hide/show depends on these flags — init before anything that can throw.
      initScrollFlags();
      document.addEventListener("astro:page-load", initScrollFlags);

      // #contact / #newsletter / #popup links — do not wait on Init island hydrate.
      bindModalLinks();

      initStandaloneLightboxes();
    </script>
    <!-- client:load so #hash openers work immediately (interaction only hydrates on island click / 8s) -->
    <Dialog link="contact" type="contact" client:load>
      <Contact client:idle contact={contact?.data?.form} slot="content">
        {
          contact?.data?.form?.intro && (
            <div
              set:html={marked.parse(contact.data.form.intro)}
              slot="content"
            />
          )
        }
      </Contact>
      <SmartPicture
        slot="image"
        src={contact?.data?.form?.thumbnail}
        alt={`contact`}
        sizes={sizesContactDialog()}
        widths={widthsForDisplay(640)}
        class="h-full w-full object-cover"
      />
    </Dialog>

    {
      newsletters().map((item) => (
        <Dialog
          link={item.link || "newsletter"}
          type="newsletter"
          client:load
        >
          <Newsletter
            client:idle
            slot="content"
            data={item}
            provider="mailchimp"
          />

          <SmartPicture
            slot="image"
            src={item.thumbnail}
            alt={item.title || "newsletter"}
            sizes={sizesContactDialog()}
            widths={widthsForDisplay(640)}
            class="h-full w-full object-cover"
          />
        </Dialog>
      ))
    }

    <Dialog link="auth" type="auth" client:load>
      <div slot="content">
        <Auth client:idle />
      </div>
      <SmartPicture
        slot="image"
        src={contact?.data?.auth?.thumbnail}
        alt={`Auth`}
        sizes={sizesContactDialog()}
        widths={widthsForDisplay(640)}
        class="h-full w-full object-cover"
      />
    </Dialog>
  </body>
</html>
