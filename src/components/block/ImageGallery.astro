---
import SmartPicture from "@components/media/SmartPicture.astro";
import LightboxGallery from "@components/media/LightboxGallery.vue";
import { Icon } from "astro-icon/components";
import { t } from "@util/translate";
import { sizesGallery, widthsGallery } from "@util/images";
import { getLightboxImage } from "@util/lightbox";

const { title, images, style, aspect } = Astro.props;
const sizes = sizesGallery(style?.container);
const widths = widthsGallery(style?.container);
const gridClasses: Record<string, string> = {
  sm: "grid grid-cols-2 gap-[var(--grid-spacing)] sm:grid-cols-3",
  md: "grid grid-cols-2 gap-[var(--grid-spacing)] sm:grid-cols-3",
  lg: "grid grid-cols-2 gap-[var(--grid-spacing)] sm:grid-cols-3",
  xl: "grid grid-cols-2 gap-[var(--grid-spacing)] sm:grid-cols-3 lg:grid-cols-4",
  full: "grid grid-cols-2 gap-[var(--grid-spacing)] sm:grid-cols-3 lg:grid-cols-4 2xl:grid-cols-5",
};
const gridClass =
  gridClasses[String(style?.container ?? "md")] ||
  "grid gap-[var(--grid-spacing)]";

const slides = (
  await Promise.all(
    (images || []).map(async (image: string) => ({
      image,
      lightbox: await getLightboxImage(image),
    })),
  )
).filter((slide) => slide.lightbox);
---

<div class={`container-${style.container} gap-8 grid`}>
  <h2 class="title-sm fade-in">{title}</h2>
  <LightboxGallery
    client:visible
    id={`gallery-${title || "images"}`}
    className={gridClass}
  >
    {
      slides.map(({ image, lightbox }, index) => (
        <a
          aria-label={t("enlarge_image")}
          style={`--animation-delay: ${(index + 1) * 150}ms`}
          class="fade-up group relative block overflow-hidden rounded-md"
          href={lightbox!.href}
          data-pswp-width={lightbox!.width}
          data-pswp-height={lightbox!.height}
          data-cropped="true"
          target="_blank"
          rel="noreferrer"
        >
          <div class="transition-transform duration-1000 ease-in group-hover:scale-110 group-hover:duration-[2s]">
            <SmartPicture
              src={image}
              alt={image}
              sizes={sizes}
              widths={widths}
              aspect={aspect}
              class={
                aspect ? "h-auto w-full object-cover" : "h-auto w-full"
              }
              style={aspect ? `aspect-ratio: ${aspect}` : undefined}
            />
          </div>
          <div class="absolute inset-0 z-10 opacity-0 transition-all duration-1000 hover:opacity-100">
            <Icon
              name="zoom"
              class="pointer-events-none absolute right-4 top-4 h-6 w-6 opacity-80"
            />
          </div>
        </a>
      ))
    }
  </LightboxGallery>
</div>

