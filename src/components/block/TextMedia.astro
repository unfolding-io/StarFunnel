---
import SmartPicture from "@components/media/SmartPicture.astro";
import { widthsColumn, widthsViewport } from "@util/images";
import { Icon } from "astro-icon/components";
import { marked } from "marked";
import Button from "@components/navigation/Button.astro";
import VideoInline from "@components/media/VideoInline.vue";
import VideoDialog from "@components/dialog/VideoDialog.vue";
import VideoDialogBtn from "@components/media/VideoDialogBtn.vue";

type ButtonItem = {
  href: string;
  label: string;
  className?: string;
  color?: string;
  icon?: string;
  icon_only?: boolean;
};

const { media, style, content, buttons } = Astro.props;

const renderedContent = marked.parse(content);
const containerSizes: Record<string, string> = {
  sm: "40rem",
  md: "55rem",
  lg: "65rem",
  xl: "75rem",
  full: "100vw",
  none: "100vw",
};
const containerKey = String(style.container ?? "md");
const roundedClass =
  style.template == "column" && style.container !== "none" ? "rounded" : "";

let sizes = "100vw";
if (style.template === "column") {
  const percent = (100 / parseInt(media.image_size)).toFixed(2);
  const sizesArray = [`(max-width: 767px) calc(100vw - 4rem)`];
  sizesArray.push(
    `(max-width: ${containerSizes[containerKey]}) calc((100vw - 6rem) / ${percent} )`,
  );
  sizesArray.push(
    `(min-width: ${containerSizes[containerKey]}) calc(${containerSizes[containerKey]} / ${percent} - 2rem)`,
  );
  sizesArray.push(`calc(100vw - 2rem)`);
  sizes = sizesArray.join(", ");
} else {
  sizes = `min(100vw, ${containerSizes[containerKey]})`;
}

const imageName = media.thumbnail.split("/").pop().split(".")[0];
const columnWidths = widthsColumn(style.container, media.image_size);
const bannerWidths = widthsViewport(1920);

const mediaClass = () => {
  if (!media?.aspect) return " ";
  if (media.aspect == 1.777) return "aspect-video";
  if (media.aspect == 1.25) return "aspect-5/4";
  if (media.aspect == 0.8) return "aspect-4/5";
  if (media.aspect == 0.5625) return "aspect-9/16";
  if (media.aspect == 1) return "aspect-square";
  return "";
};

const hasPreviewVideo = media?.video_preview?.trim() || false;
const hasEmbed = !!media?.video_id?.trim() || false;
const isColumn = style.template === "column";
const isRow = style.template === "row";
const isBanner = style.template === "banner";
const imageSize = String(media.image_size || "50");
const direction = style.reverse ? "reverse" : "normal";

const columnSizeClasses: Record<string, string> = {
  "25": "md:grid-cols-[minmax(0,3fr)_minmax(0,1fr)]",
  "33": "md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]",
  "50": "md:grid-cols-2",
  "66": "md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]",
  "75": "md:grid-cols-[minmax(0,1fr)_minmax(0,3fr)]",
};
const columnSizeReverseClasses: Record<string, string> = {
  "25": "md:grid-cols-[minmax(0,1fr)_minmax(0,3fr)]",
  "33": "md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]",
  "50": "md:grid-cols-2",
  "66": "md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]",
  "75": "md:grid-cols-[minmax(0,3fr)_minmax(0,1fr)]",
};
const columnSizeClass = columnSizeClasses[imageSize] || "md:grid-cols-2";
const columnSizeReverseClass =
  columnSizeReverseClasses[imageSize] || "md:grid-cols-2";

const rootClass = [
  `container-${style.container}`,
  "text-image gap-8",
  isColumn &&
    `column-grid column-grid-${imageSize} grid gap-8 lg:gap-14 ${
      style.reverse ? columnSizeReverseClass : columnSizeClass
    }`,
  isRow &&
    `text-image-row relative flex flex-col flex-nowrap ${
      style.reverse ? "flex-col-reverse" : ""
    }`,
  isBanner &&
    `text-image-banner parallax-wrap relative overflow-hidden bg-dark ${
      style.container !== "none" ? "rounded-md" : ""
    }`,
  direction,
].filter(Boolean).join(" ");
---

<div class={rootClass}>
  <div class="media">
    {
      imageName && (
        <>
          {style.template !== "banner" && media.video_id && (
            <VideoDialogBtn
              client:visible
              video_id={media?.video_id}
              className={`${
                !hasEmbed || "group"
              } relative w-full overflow-hidden ${roundedClass} ${mediaClass()}`}
            >
              <div class="h-full w-full transition-transform duration-1000 ease-in hover:scale-105 hover:duration-[1s]">
                {hasPreviewVideo && (
                  <VideoInline url={media.video_preview} client:visible>
                    <SmartPicture
                      src={media.thumbnail}
                      alt={media.title}
                      aspect={media.aspect}
                      sizes={sizes}
                      widths={columnWidths}
                      class="h-auto w-full object-cover"
                    />
                    {hasEmbed && (
                      <div class="pointer-events-none absolute inset-0 z-50 grid place-items-center">
                        <Icon
                          name="play"
                          class="h-20 w-20 text-secondary transition-transform duration-300 group-hover:scale-125"
                        />
                      </div>
                    )}
                  </VideoInline>
                )}
                {!hasPreviewVideo && (
                  <SmartPicture
                    src={media.thumbnail}
                    alt={media.title}
                    aspect={media.aspect}
                    sizes={sizes}
                    widths={columnWidths}
                    class="h-auto w-full object-cover"
                  />
                )}
              </div>
            </VideoDialogBtn>
          )}

          {style.template !== "banner" && !media.video_id && (
            <div
              class={`${
                !hasEmbed || "group"
              } relative w-full overflow-hidden ${roundedClass} ${mediaClass()}`}
            >
              {hasPreviewVideo && (
                <VideoInline url={media.video_preview} client:visible>
                  <SmartPicture
                    src={media.thumbnail}
                    alt={media.title}
                    aspect={media.aspect}
                    sizes={sizes}
                    widths={columnWidths}
                    class="h-auto w-full object-cover"
                  />
                  {hasEmbed && (
                    <div class="pointer-events-none absolute inset-0 z-50 grid place-items-center">
                      <Icon
                        name="play"
                        class="h-20 w-20 text-secondary transition-transform duration-300 group-hover:scale-125"
                      />
                    </div>
                  )}
                </VideoInline>
              )}
              {!hasPreviewVideo && (
                <SmartPicture
                  src={media.thumbnail}
                  alt={media.title}
                  aspect={media.aspect}
                  sizes={sizes}
                  widths={columnWidths}
                  class="h-auto w-full object-cover"
                />
              )}
            </div>
          )}

          {style.template === "banner" && hasPreviewVideo && (
            <div
              class={`parallax h-full w-full opacity-${media.opacity || "60"}`}
            >
              <VideoInline url={media.video_preview} client:visible>
                <SmartPicture
                  src={media.thumbnail}
                  aspect={2.25}
                  alt={media.title}
                  sizes={sizes}
                  widths={bannerWidths}
                  class="h-full w-full object-cover"
                />
              </VideoInline>
            </div>
          )}

          {style.template === "banner" && !hasPreviewVideo && (
            <SmartPicture
              src={media.thumbnail}
              aspect={2.25}
              alt={media.title}
              sizes={sizes}
              widths={bannerWidths}
              class={`parallax h-full w-full object-cover opacity-${media.opacity || "60"}`}
            />
          )}
        </>
      )
    }
  </div>

  <div class="text-image__content z-20 my-auto flex h-full flex-1">
    <div class="my-auto">
      <div
        set:html={renderedContent}
        class="richtext fade-up"
        style="--animation-delay: 0.4s"
      />

      {
        buttons && (
          <div
            style="--animation-delay: 0.6s"
            class={`fade-up inline-flex flex-wrap gap-4 ${
              style.template === "banner"
                ? "mb-8 w-full justify-center py-0"
                : "py-8"
            }`}
          >
            {buttons.map((btn: ButtonItem) => (
              <Button {...btn} />
            ))}
          </div>
        )
      }

      {
        hasEmbed && style.template === "banner" && (
          <VideoDialogBtn
            client:visible
            video_id={media?.video_id}
            className="group grid w-full place-items-center"
          >
            <Icon
              name="play"
              class="h-20 w-20 text-secondary transition-transform duration-300 group-hover:scale-125"
            />
          </VideoDialogBtn>
        )
      }
    </div>
  </div>
</div>

{
  hasEmbed && (
    <VideoDialog
      client:only="vue"
      video_id={media?.video_id}
      embed={media?.embed}
    />
  )
}

