---
import { getEntry } from "astro:content";
import SmartPicture from "@components/media/SmartPicture.astro";
import { sizesBanner, widthsViewport } from "@util/images";
import { Icon } from "astro-icon/components";
import { marked } from "marked";

import Popup from "@components/dialog/Popup.vue";
import Button from "@components/navigation/Button.astro";
import { surfaceClass } from "@util/surfaces";

type ButtonItem = {
  href: string;
  label: string;
  className?: string;
  color?: string;
  icon?: string;
  icon_only?: boolean;
};

const { content, link, code, media, buttons, style, timing, newsletter } =
  Astro.props;
const popupSurface = surfaceClass(style?.surface || "dark");
let newsletterItem: Record<string, unknown> | undefined;
const renderedContent = marked.parse(content);

if (newsletter) {
  const contact = await getEntry("config", "contact");

  newsletterItem = contact?.data?.newsletter?.list
    ?.filter((list) => list.link === newsletter)
    .pop();
}
---

{
  timing.on_load && (
    <>
      <Popup
        client:interaction
        data={timing}
        {link}
        {code}
        newsletter={newsletterItem}
        className={`${popupSurface} `}
      >
        <Icon name="close" class="w-6" slot="close" />
        <div class={`relative z-10 p-8`} slot="content">
          <div
            set:html={renderedContent}
            class="richtext fade-up"
            style="--animation-delay: 0.4s"
          />
        </div>

        {buttons && (
          <div
            slot="buttons"
            style="--animation-delay: 0.6s"
            class={`fade-up relative z-10 inline-flex flex-wrap gap-4 py-8`}
          >
            {buttons.map((btn: ButtonItem) => (
              <Button {...btn} />
            ))}
          </div>
        )}

        <div
          class="absolute inset-0 z-0"
          style={`opacity: ${media.image_opacity}`}
          slot="image"
        >
          {media.thumbnail && (
            <SmartPicture
              src={media.thumbnail}
              aspect={2.25}
              alt={"background image"}
              sizes={sizesBanner()}
              widths={widthsViewport(1920)}
              class="h-full w-full object-cover"
            />
          )}
        </div>
      </Popup>
    </>
  )
}

{
  !timing.on_load && (
    <Popup
      client:visible
      data={timing}
      {link}
      {code}
      newsletter={newsletterItem}
      className={`${popupSurface} `}
    >
      <Icon name="close" class="w-6" slot="close" />
      <div class={`relative z-10 p-8`} slot="content">
        <div
          set:html={renderedContent}
          class="richtext fade-up"
          style="--animation-delay: 0.4s"
        />
      </div>

      {buttons && (
        <div
          slot="buttons"
          style="--animation-delay: 0.6s"
          class={`fade-up relative z-10 inline-flex flex-wrap gap-4 py-8`}
        >
          {buttons.map((btn: ButtonItem) => (
            <Button {...btn} />
          ))}
        </div>
      )}

      <div
        class="absolute inset-0 z-0"
        style={`opacity: ${media.image_opacity}`}
        slot="image"
      >
        {media.thumbnail && (
          <SmartPicture
            src={media.thumbnail}
            aspect={2.25}
            alt={"background image"}
            sizes={sizesBanner()}
            widths={widthsViewport(1920)}
            class="h-full w-full object-cover"
          />
        )}
      </div>
    </Popup>
  )
}
