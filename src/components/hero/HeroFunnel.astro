---
import SmartPicture from "@components/media/SmartPicture.astro";
import { sizesSplitHero, widthsViewport } from "@util/images";
import { marked } from "marked";
import { Icon } from "astro-icon/components";
import Button from "@components/navigation/Button.astro";
import VideoInline from "@components/media/VideoInline.vue";
import VideoDialog from "@components/dialog/VideoDialog.vue";
import VideoDialogBtn from "@components/media/VideoDialogBtn.vue";
import { surfaceClass } from "@util/surfaces";

type ButtonItem = {
  href: string;
  label: string;
  className?: string;
  color?: string;
  icon?: string;
  icon_only?: boolean;
};

const { title, hero } = Astro.props;
const { slug } = Astro.params;
const heroSurface = surfaceClass(hero?.style?.surface || "dark");
const hasImage = !!hero?.media?.thumbnail?.trim() || false;
const hasBgImage = !!hero?.media?.background_image?.trim() || false;
const hasPreviewVideo = !!hero?.media?.video_preview?.trim() || false;
const hasVideo = !!hero?.media?.video_preview?.trim() || false;
const hasEmbed = !!hero?.media?.video_id?.trim() || false;
const hasMedia = hasImage || hasVideo || hasPreviewVideo;
const isRow = hero?.style?.layout === "row";
const mediaClass = () => {
  if (!hero?.media?.aspect) return "";
  if (hero.media.aspect == 1) return "aspect-square";
  if (hero.media.aspect == 1.777) return "aspect-video";
  if (hero.media.aspect == 1.25) return "aspect-5/4";
  if (hero.media.aspect == 0.8) return "aspect-4/5";
  if (hero.media.aspect == 0.5625) return "aspect-9/16";
  return "";
};
---

{
  hero && (
    <div
      class={`hero-funnel parallax-wrap relative z-20 grid min-h-[max(80vh,30rem)] place-items-center overflow-hidden ${heroSurface} ${
        hero?.style?.class || ""
      } ${hero?.style?.layout || ""} ${hero?.style?.media || ""}`}
      transition:name={`hero_${slug || Math.random()}`}
      id="header"
    >
      <div
        class={`parallax pointer-events-none absolute inset-0 bg-${
          hero?.style?.background || ""
        }`}
      />
      {hero?.style?.pattern && (
        <div
          class="parallax absolute inset-0"
          style={`${hero?.style?.pattern || ""}  `}
        />
      )}
      {hasBgImage && (
        <div class="media parallax absolute inset-0">
          <SmartPicture
            src={hero.media.background_image}
            aspect={16 / 10}
            alt={title}
            sizes="100vw"
            widths={widthsViewport(1920)}
            priority
            class="h-full w-full object-cover sm:h-screen"
            style={`opacity: ${hero?.media?.image_opacity || 0.7}`}
          />
        </div>
      )}

      <div class="relative z-10 grid w-full place-items-center">
        <div
          class={`container-${hero?.style?.container || "xl"} grid grid-cols-1 gap-10 py-14 ${
            isRow
              ? "hero-funnel__row-grid text-center"
              : "hero-funnel__col-grid place-items-center text-center md:grid-cols-[5fr_4fr] md:text-left"
          }`}
        >
          <div class="mx-auto grid max-w-3xl gap-8 pt-20 md:pb-10">
            {hero?.title && (
              <h1 class="title" set:html={marked.parse(hero.title)} />
            )}
            {hero.intro && (
              <div
                class="balance text-lg"
                set:html={marked.parse(hero.intro)}
              />
            )}

            {hero.buttons && hero.buttons.length > 0 && (
              <div
                class={`hero-funnel__buttons mt-2 flex flex-wrap gap-4 justify-center ${
                  isRow ? "" : "md:justify-start"
                }`}
              >
                {hero.buttons.map((btn: ButtonItem) => (
                  <Button {...btn} />
                ))}
              </div>
            )}
            <slot />
          </div>

          <div class="relative grid w-full place-items-center self-center">
            {hasMedia && (
              <VideoDialogBtn
                client:load
                video_id={hero?.media?.video_id}
                className={`hero-funnel__media relative w-full max-h-[max(20rem,70vh)] overflow-hidden rounded aspect-video ${mediaClass()} ${
                  hasEmbed ? "group" : ""
                } ${!isRow ? "max-w-lg" : ""}`}
              >
                {hasPreviewVideo && (
                  <VideoInline
                    url={hero.media.video_preview}
                    client:media-idle="(min-width: 0px)"
                    delay
                  >
                    <SmartPicture
                      src={
                        hero?.media?.thumbnail
                          ? hero.media.thumbnail
                          : "/src/assets/system/video-placeholder.jpeg"
                      }
                      alt={hero.title}
                      sizes={sizesSplitHero()}
                      widths={widthsViewport(580)}
                      aspect={hero.media?.aspect ? hero.media?.aspect : 1.777}
                      priority
                      class="h-full w-full object-cover"
                    />
                    {hasEmbed && (
                      <div class="pointer-events-none absolute inset-0 z-50 grid place-items-center">
                        <Icon
                          name="play"
                          class="h-20 w-20 text-secondary transition-transform duration-300 group-hover:scale-125"
                        />
                      </div>
                    )}
                  </VideoInline>
                )}
                {!hasPreviewVideo && (
                  <SmartPicture
                    src={hero.media.thumbnail}
                    alt={hero.title}
                    sizes={sizesSplitHero()}
                    widths={widthsViewport(580)}
                    aspect={hero.media?.aspect ? hero.media?.aspect : 1.777}
                    priority
                    class="h-full w-full object-cover"
                  />
                )}
              </VideoDialogBtn>
            )}
          </div>
        </div>
      </div>
      <div
        class={`hero-funnel__divider absolute inset-x-0 bottom-0 z-0 -mb-px flex min-h-20 min-w-[1200px] flex-col overflow-hidden ${
          isRow ? "hero-funnel__divider--row" : ""
        }`}
      >
        <span
          class="hero-funnel__wave surface-base -mb-px block h-72 w-full shrink-0 md:-mb-20 md:h-40"
          style="clip-path: url(#heroclip)"
        />
        <div class="surface-base h-full w-full" />
      </div>
    </div>
  )
}
<svg
  xmlns="http://www.w3.org/2000/svg"
  width="0"
  height="0"
  viewBox="0 0 1200 220.2"
  aria-hidden="true"
>
  <defs>
    <clipPath
      id="heroclip"
      clipPathUnits="objectBoundingBox"
      transform="scale(0.0008333, 0.0045413)"
    >
      <path
        d="M0 82.8v137.4h1200V14.3c-67.8-23.1-144.3-15.5-214.3 3-79 20.8-161.9 61.8-241.8 78.6-82.3 17.3-168.1 16.3-250.5-.4-57.8-11.7-114-31.1-172-41.9C213.6 33.9 102.5 44 0 82.8z"
      ></path>
    </clipPath>
  </defs>
</svg>
{
  hasEmbed && (
    <VideoDialog
      client:only="vue"
      video_id={hero?.media?.video_id}
      embed={hero?.media?.embed}
    />
  )
}

