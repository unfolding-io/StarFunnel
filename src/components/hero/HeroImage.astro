---
import SmartPicture from "@components/media/SmartPicture.astro";
import { widthsViewport } from "@util/images";
import ItemFilter from "@components/navigation/ItemFilter.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { marked } from "marked";
import { surfaceClass } from "@util/surfaces";

const {
  title,
  thumbnail,
  intro,
  tag,
  filter,
  filters,
  filter_type,
  style,
  pubDate,
  base_url,
} = Astro.props;

const { slug } = Astro.params;
const heroSurface = surfaceClass(style?.hero_surface || "dark");
---

<div
  class={`hero-image relative mt-28 mb-14 overflow-hidden rounded parallax-wrap container-md ${heroSurface}`}
  transition:name={`hero_${slug || Math.random()}`}
  id="header"
>
  {
    thumbnail && (
      <div
        class="media parallax absolute inset-0 w-full"
        style={`opacity: ${style.hero_image_opacity || 0.7}`}
      >
        <SmartPicture
          src={thumbnail}
          aspect={21 / 9}
          alt={title}
          sizes="(min-width: 1024px) 990px, calc(100vw - 2rem)"
          widths={widthsViewport(1920)}
          priority
          class="h-full w-full object-cover"
        />
      </div>
    )
  }

  <div class="relative z-10 grid place-items-center bg-dark/20">
    <div class="container-sm pb-20 pt-40">
      <div class="max-w-3xl">
        {
          pubDate && (
            <span class="text-overline">
              <FormattedDate date={pubDate} />
            </span>
          )
        }
        <h1 class="title" set:html={title} />
        {
          intro && (
            <div class="subtitle balance py-2" set:html={marked.parse(intro)} />
          )
        }

        <slot />
      </div>
    </div>
  </div>
  <div class="absolute right-10 top-5 z-10">
    {
      tag && (
        <ItemFilter
          filters={tag}
          className="mt-4 justify-start"
          links={true}
          {base_url}
        />
      )
    }

    {
      filters && (
        <ItemFilter
          filters={filters}
          className="mt-4"
          links={true}
          active={filter}
          type={filter_type}
          {base_url}
        />
      )
    }
  </div>
</div>

<style is:global>
  .hero-image .title strong,
  .hero-image .title bold {
    color: var(--color-primary);
  }
</style>
