---
/* BLOG ARCHIVE PAGES BY TAG */
import type { CollectionEntry } from "astro:content";
import { getCollection, getEntry } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Intersecting from "@components/common/Intersecting.vue";
import ItemCard from "@components/cards/ItemCard.astro";
import Pager from "@components/navigation/Pager.astro";
import { slugify, getCategoryData, getPagination } from "@util/helpers";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .filter((post) => !!post.data?.tag);

  const blogEntry = await getEntry("config", "blog");
  const blogData = blogEntry?.data ?? {};
  const allFilters = posts
    .map((post) => post.data.tag)
    .filter((post) => !!post);
  const filters = [...new Set(allFilters.flat(1))] as string[];

  return getPagination(posts, filters, blogData, "tag").map((path) => ({
    ...path,
    props: {
      ...path.props,
      blogData,
    },
  }));
}

type Props = {
  lastPage: number;
  currentPage: number;
  page: CollectionEntry<"blog">[];
  filter: string;
  filters: string[];
  filter_type: string;
  tag?: string;
  blogData: CollectionEntry<"config">["data"];
};

const {
  lastPage,
  currentPage,
  page,
  filter,
  filters,
  filter_type,
  tag,
  blogData,
} = Astro.props as Props;

const base_url = import.meta.env.BLOG_SLUG || "news";

const pageData = getCategoryData(blogData?.blog_tags, filter);
const data = {
  ...blogData,
  ...pageData,
};

const pagerSlug = `${base_url}/${filter_type}/${slugify(filter)}`;
const sizes =
  "(max-width: 639px) calc(100vw - 4rem), (min-width: 1024px) 450px,  calc(50vw - 4rem )";
---

<PageLayout
  page={{
    data: page,
    lastPage: lastPage,
    currentPage: currentPage,
  }}
  {...data}
  {filters}
  {filter}
  {base_url}
  {tag}
>
  <section>
    <ul class={`grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-8 lg:gap-20 pb-20`}>
      {
        page.map((post) => (
          <li>
            <Intersecting client:visible>
              <ItemCard content={post} {base_url} {sizes} animate={true} />
            </Intersecting>
          </li>
        ))
      }
    </ul>
    {
      lastPage > 1 && (
        <div class="container-md pb-4">
          <Pager
            totalPage={lastPage}
            currentPage={currentPage}
            url={pagerSlug}
          />
        </div>
      )
    }
  </section>
</PageLayout>
